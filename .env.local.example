# Copia este archivo como .env.local y rellena con tus credenciales de Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Enlace de invitación al servidor oficial de Discord (público)
# Discord → Servidor → Invitar personas → Copiar enlace (sin expiración, usos ilimitados)
NEXT_PUBLIC_DISCORD_INVITE_URL=https://discord.gg/bUxCczqaS

# Canal oficial de Telegram (enlace de invitación público)
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/+OJ6SMrfuzb8xNTU5

# Solo servidor — Service Account para verificar suscriptores (Vercel)
# Firebase Console → Configuración del proyecto → Cuentas de servicio → Generar clave privada
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Email(s) del autor fundador Pedro — separados por coma si hay más de uno
# Al iniciar sesión con este email, se vincula automáticamente como autor
FOUNDER_AUTHOR_PEDRO_EMAIL=pgarcialiteratura@gmail.com

# Email(s) del autor fundador WillFlechas
FOUNDER_AUTHOR_WILL_EMAIL=willflechas77@gmail.com

# Email(s) de administradoras del sitio — acceso premium total y panel de administración
SITE_ADMIN_EMAILS=yhineth.alexandra.01@gmail.com

# PayPal — pagos de suscripción, compras y donaciones
# Developer Dashboard: https://developer.paypal.com/dashboard/applications
# Sandbox: PAYPAL_MODE=sandbox | Producción: PAYPAL_MODE=live
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Webhook ID del endpoint https://TU_DOMINIO/api/paypal/webhook
PAYPAL_WEBHOOK_ID=
# Opcional: plan de suscripción ya creado en PayPal (si no, se crea y cachea solo)
# PAYPAL_SUBSCRIPTION_PLAN_ID=

# URL pública de la app (producción)
NEXT_PUBLIC_APP_URL=https://tinta-club.vercel.app

# Secreto para scripts admin (revocar membresías vía POST /api/admin/revoke-member)
ADMIN_API_SECRET=

# Cron de cierre mensual de ganancias (POST /api/cron/close-month, header x-admin-secret)
CRON_SECRET=
