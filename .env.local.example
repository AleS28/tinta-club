# Copia este archivo como .env.local y rellena con tus credenciales de Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Enlace de invitación al servidor oficial de Discord (público)
# Discord → Servidor → Invitar personas → Copiar enlace (sin expiración, usos ilimitados)
NEXT_PUBLIC_DISCORD_INVITE_URL=https://discord.gg/tu-enlace-aqui

# Canal oficial de Telegram (enlace de invitación público)
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/+OJ6SMrfuzb8xNTU5

# Solo servidor — Service Account para verificar suscriptores (Vercel)
# Firebase Console → Configuración del proyecto → Cuentas de servicio → Generar clave privada
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Email(s) del autor fundador Pedro — separados por coma si hay más de uno
# Al iniciar sesión con este email, se vincula automáticamente como autor
FOUNDER_AUTHOR_PEDRO_EMAIL=pedro@ejemplo.com

# Stripe — pagos de suscripción (lectores)
# Dashboard: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# URL pública de la app (producción)
NEXT_PUBLIC_APP_URL=https://tinta-club.vercel.app
