rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function touchesStorePricing() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['directBookPriceUsd', 'directChapterPriceUsd', 'saleMode', 'pricingUpdatedAt', 'pricingUpdatedBy']);
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId;

      match /favorites/{bookId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /following/{authorId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /books/{bookId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (isAdmin() || !touchesStorePricing());
    }

    match /chapters/{chapterId} {
      allow read: if true;
      allow create, update: if request.auth != null;
    }

    match /feedback/{docId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // Registro inmutable de aceptaciones legales (lectores y autores)
    match /artifacts/{appId}/users/{userId}/legal_agreements/{agreementId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if false;
    }

    // Monetización — solo servidor (Admin SDK)
    match /reading_sessions/{docId} {
      allow read, write: if false;
    }

    match /direct_chapter_sales/{docId} {
      allow read, write: if false;
    }

    match /monthly_pools/{docId} {
      allow read, write: if false;
    }

    match /author_earnings_summary/{docId} {
      allow read, write: if false;
    }

    match /premium_view_windows/{docId} {
      allow read, write: if false;
    }

    match /statistical_view_windows/{docId} {
      allow read, write: if false;
    }

    match /reading_cap_sessions/{docId} {
      allow read, write: if false;
    }

    match /stripe_processed_events/{docId} {
      allow read, write: if false;
    }

    match /chapter_purchases/{docId} {
      allow read, write: if false;
    }

    match /book_purchases/{docId} {
      allow read, write: if false;
    }

    match /direct_book_sales/{docId} {
      allow read, write: if false;
    }

    match /book_likes/{docId} {
      allow read, write: if false;
    }

    match /book_like_stats/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /chapter_comments/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /author_followers/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /author_donations/{docId} {
      allow read, write: if false;
    }
  }
}
